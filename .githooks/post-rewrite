#!/usr/bin/env bash
# Syncs the global install after git rebase or git pull --rebase. ORIG_HEAD is the branch tip
# before the rebase. Amends are skipped here because post-commit already handles them.
set -euo pipefail
[[ "${1:-}" == rebase ]] || exit 0
exec bash "$(dirname "$0")/sync-global-install.sh" ORIG_HEAD
